{
  "name": "customer-insights-site",
  "private": true,
  "version": "0.1.0",
  "description": "Single-page site for the Customer Insights & Analytics team.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "watch": "vite build --watch",
    "serve": "python3 -m http.server 3001 --bind 127.0.0.1 -d dist",
    "check": "node scripts/render-page.mjs --check",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run check && npm run build && npm run smoke",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27"
  },
  "devDependencies": {
    "linkedom": "^0.18.14",
    "playwright": "^1.64.1",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
