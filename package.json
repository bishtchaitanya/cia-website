{
  "name": "customer-insights-site",
  "private": true,
  "version": "0.1.0",
  "description": "Single-page site for the Customer Insights & Analytics team.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:admin": "vite build --config vite.admin.config.js",
    "watch": "vite build --watch",
    "serve": "node scripts/serve.mjs",
    "admin": "node scripts/admin-server.mjs",
    "admin:hash": "node scripts/admin-hash.mjs",
    "test:admin": "node scripts/admin-test.mjs",
    "test:admin:dashboards": "node scripts/admin-dashboards-test.mjs",
    "test:dashboards": "node scripts/dashboards-test.mjs",
    "dashboards:import": "node scripts/dashboards-import.mjs",
    "check": "node scripts/render-page.mjs --check",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run check && npm run build && npm run smoke",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "linkedom": "^0.18.14",
    "playwright": "^1.64.1",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
